{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "regexManagers": [
    {
      "description": "Watch Kairos GitHub releases and bump the pinned channel file",
      "fileMatch": ["^kairos-channel\\.yaml$"],
      "matchStrings": ["kairosRelease: (?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kairos-io/kairos"
    },
    {
      "description": "Watch instantlinux/spamassassin Docker Hub tags and bump BASE_TAG in the spamd image Dockerfile (the build itself is driven by Flux via --build-arg)",
      "fileMatch": ["^images/spamd/Dockerfile$"],
      "matchStrings": ["ARG BASE_TAG=(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "instantlinux/spamassassin"
    }
  ],
  "packageRules": [
    {
      "description": "Only use GitHub Releases for NFD Kustomize remote",
      "matchManagers": ["kustomize"],
      "matchDepNames": ["kubernetes-sigs/node-feature-discovery"],
      "overrideDatasource": "github-releases",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Let new Kairos releases settle before proposing them",
      "matchDepNames": ["kairos-io/kairos"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
